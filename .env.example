# FinSight 로컬 개발 설정: 실제 값은 .env에 입력하세요.
# 외부 서비스의 빈 값은 각 서비스 콘솔에서 발급받아 채웁니다.
# Vercel 배포 시에는 환경별 설정에 따로 등록하세요.

# 앱 주소. 결제 복귀 URL은 이 주소 + /dashboard?checkout=success로 구성합니다.
APP_URL=http://localhost:3000

# Neon Postgres 연결 문자열 (sslmode=require 포함)
DATABASE_URL=""

# Auth.js v5: .env의 AUTH_SECRET은 로컬 생성값입니다.
# 다른 환경에서는 별도의 암호학적으로 안전한 난수 값을 사용하세요.
# https://authjs.dev/getting-started/deployment
AUTH_SECRET=""

# Google OAuth: 웹 애플리케이션의 클라이언트 ID와 비밀키
# 로컬 리디렉션 URI: http://localhost:3000/api/auth/callback/google
# https://authjs.dev/getting-started/providers/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Anthropic: 서버 전용 API 키와 분석 모델
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=claude-sonnet-5-5

# Polar: 로컬에서는 sandbox, 운영에서는 production
# 토큰, 웹훅 시크릿, Pro 상품 ID는 같은 환경에서 발급한 값을 사용하세요.
# https://polar.sh/docs/integrate/sdk/typescript
POLAR_SERVER=sandbox
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""
POLAR_PRO_PRODUCT_ID=""

# APP_URL, ANTHROPIC_MODEL, POLAR_SERVER, POLAR_PRO_PRODUCT_ID는
# 앱 구현 시 서버 설정에서 읽어 SDK 및 라우트에 연결할 프로젝트 설정입니다.
# Drizzle 등 Next.js 외부 CLI에서도 .env을 명시적으로 로드해야 합니다.
